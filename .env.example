# =============================================================================
# 恒聘通 HRM 环境变量模板
#
# 使用方法：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 按真实值填充下方变量
#   3. .env 已在 .gitignore 中，绝不要提交
# =============================================================================

# ----- 应用元信息 -----
# 不在根 .env 中设置 NODE_ENV：Vite 会读取根 .env，生产值会导致前端构建警告。
# 后端生产模式由 docker-compose.yml 默认值或部署平台环境变量设置。
COMPOSE_PROJECT_NAME=hengpintong-saas-preview

# ----- 数据库（MySQL）-----
MYSQL_ROOT_PASSWORD=PLEASE_CHANGE_ME_root
MYSQL_DATABASE=hengpintong_saas
MYSQL_USER=hengpintong_saas
MYSQL_PASSWORD=PLEASE_CHANGE_ME_app

# 后端访问数据库时使用的连接信息（容器内部走 service name）
DB_HOST=mysql
DB_PORT=3306
DB_USER=hengpintong_saas
DB_PASSWORD=PLEASE_CHANGE_ME_app
DB_NAME=hengpintong_saas

DB_READONLY_HOST=mysql
DB_READONLY_PORT=3306
DB_READONLY_USER=hengpintong_saas_ro
DB_READONLY_PASSWORD=PLEASE_CHANGE_ME_readonly
DB_READONLY_NAME=hengpintong_saas

# ----- 鉴权 -----
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=PLEASE_CHANGE_ME_random_64_chars
SECRET_KEY=PLEASE_CHANGE_ME_random_32_chars

# ----- SaaS / 租户初始化 -----
# 第一版使用统一域名 + 企业编码登录；默认企业编码为 HPT-00000001。
DEFAULT_TENANT_SLUG=HPT-00000001
TENANT_CODE_PREFIX=HPT
TENANT_CODE_WIDTH=8
DEFAULT_TENANT_NAME=默认企业
# 平台管理员通过企业编码 platform 登录；仅用于初始化首个平台开户。
PLATFORM_ADMIN_EMAIL=platform@example.com
PLATFORM_ADMIN_PASSWORD=PLEASE_CHANGE_ME_platform_admin
PLATFORM_ADMIN_NAME=平台管理员
# 平台创建企业管理员时的默认初始密码；客户首次登录后应强制修改。
TENANT_ADMIN_DEFAULT_PASSWORD=PLEASE_CHANGE_ME_tenant_admin
# 对外访问域名，用于后续邮件、证书、回调和诊断链接生成。
PUBLIC_APP_URL=https://hrm.example.com
PUBLIC_API_URL=https://hrm.example.com/api

# ----- CORS -----
# 生产环境严禁使用 *，应填写真实前端域名（多个用英文逗号分隔）
FRONTEND_URL=http://localhost:18280,https://localhost:18445

# ----- 端口 -----
BACKEND_PORT=18888
NGINX_PORT=18280
NGINX_HTTPS_PORT=18445

# ----- AI 服务（硅基流动）-----
SILICONFLOW_API_KEY=
SILICONFLOW_API_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3
ASSISTANT_SMALL_MODEL=deepseek-ai/DeepSeek-V3
ASSISTANT_STANDARD_MODEL=deepseek-ai/DeepSeek-V3
ASSISTANT_STRONG_MODEL=deepseek-ai/DeepSeek-V4-Pro
# SaaS 平台默认模型；后续支持“平台默认 + 租户覆盖”。
ASSISTANT_DEFAULT_MODEL=deepseek-ai/DeepSeek-V3
ASSISTANT_SKILL_FIRST_SYNTHESIS=1
ASSISTANT_SKILL_FIRST_UNDERSTANDING_TIMEOUT=8
ASSISTANT_SKILL_FIRST_PLANNER_TIMEOUT=18
ASSISTANT_SKILL_FIRST_SLOT_TIMEOUT=8
ASSISTANT_SKILL_FIRST_SYNTHESIS_TIMEOUT=5
ASSISTANT_SKILL_FIRST_LLM_HEALTH_FAILURE_THRESHOLD=8

# ----- OCR 服务（百度）-----
BAIDU_OCR_APP_ID=
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# ----- Assistant Intent Router (v2) -----
# 升级后的助手意图路由（FastPath → EntityMemory → Retriever → Reranker →
# ConfidenceGate → PermissionGate）。默认全部关闭，灰度切换不需要重启服务。
# 详细 Runbook：.kiro/specs/assistant-intent-routing-upgrade/rollout-runbook.md

# 主开关：v2 路由总开关。truthy: 1 / true / TRUE / yes（默认关闭）
ASSISTANT_INTENT_ROUTER_V2_ENABLED=false
# 灰度百分比：仅接受 0/1/10/50/100；其它值会被回落到 0（默认 0）
ASSISTANT_INTENT_ROUTER_ROLLOUT_PCT=0
# ConfidenceGate 阈值窗：[low, high] 闭区间，单位 [0, 1]（默认 0.50 / 0.75）
ASSISTANT_INTENT_ROUTER_LOW_THRESHOLD=0.50
ASSISTANT_INTENT_ROUTER_HIGH_THRESHOLD=0.75
# Reranker 单次 LLM 调用硬超时（毫秒，默认 3000）
ASSISTANT_INTENT_ROUTER_RERANKER_TIMEOUT_MS=3000
# FastPath 关键词 yaml 路径；留空则用 intent_router/fastpath_keywords.yaml
ASSISTANT_INTENT_ROUTER_FASTPATH_KEYWORDS_PATH=
# EntityMemory TTL：默认实体 30 分钟、time_window 类 10 分钟
ASSISTANT_ENTITY_MEMORY_TTL_MINUTES_DEFAULT=30
ASSISTANT_ENTITY_MEMORY_TTL_MINUTES_TIME_WINDOW=10
# Embedding 模型（SiliconFlow embeddings 端点；默认 BAAI/bge-m3）
ASSISTANT_EMBEDDING_MODEL=BAAI/bge-m3

# ----- 对象存储（培训视频/大文件）-----
# MinIO（S3 兼容）。未配置 endpoint 时 storage.py 自动回退本地 /uploads。
# 默认值对应 docker-compose 里的 minio service（开发可用）。
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=PLEASE_CHANGE_MINIO_USER
MINIO_SECRET_KEY=PLEASE_CHANGE_MINIO_PASSWORD
MINIO_BUCKET=hrm-courses
MINIO_SECURE=false
# 单视频上传上限（MB），默认 500
MAX_VIDEO_UPLOAD_MB=500

# ----- 企业微信通讯录一次性同步 -----
# 只在执行 backend-python/scripts/sync_wecom_contacts_once.py 时需要。
# 通讯录 secret 请使用企业微信后台授权了通讯录读取范围的 secret。
WECOM_CORP_ID=
WECOM_CONTACT_SECRET=
WECOM_ROOT_DEPARTMENT_ID=1
WECOM_DEFAULT_ROLE=employee
# 留空则新建账号使用随机不可知密码；如需统一初始密码可临时设置，导入后请立即清除。
WECOM_DEFAULT_PASSWORD=
# 企业微信成员没有邮箱时生成 userid@该域名，保证 HRM 用户表 email 非空且唯一。
WECOM_SYNTHETIC_EMAIL_DOMAIN=wecom.local

# ----- 00001 公司 OA 人员主数据每日同步 -----
# 仅 HPT-00000001 使用。外部 SQL Server 连接严格执行固定 SELECT 并回滚关闭。
# 生产凭据仅放部署环境，禁止提交到仓库或写入发布包。
OA_EMPLOYEE_SYNC_ENABLED=0
OA_DB_HOST=
OA_DB_PORT=2807
OA_DB_USER=
OA_DB_PASSWORD=

# ----- 00001 公司考勤机只读同步 -----
# 仅部署环境配置真实凭据。禁止写入仓库、文档、日志或发布包。
ATTENDANCE_SYNC_ENABLED=0
ATTENDANCE_DB_HOST=
ATTENDANCE_DB_PORT=2807
ATTENDANCE_DB_NAME=Kaoqin
ATTENDANCE_DB_USER=
ATTENDANCE_DB_PASSWORD=
ATTENDANCE_SYNC_LOOKBACK_DAYS=90
ATTENDANCE_SYNC_INTERVAL_SECONDS=300

# ----- 灾备 / 备份 -----
# backup-*.ps1 脚本默认将备份归档写到 C:\hengpintong-backups\
# 如需自定义路径，把下面变量设置后用 dotenv 或在 PowerShell 里 export
# 注意：脚本会读取 $env:BACKUP_DIR；docker-compose 不需要这个变量
# BACKUP_DIR=D:\hengpintong-backups
# SaaS 生产建议把备份目录放在系统盘以外，并额外同步到对象存储或异地盘。
BACKUP_DIR=D:\hengpintong-backups

# ----- 消息通知配置 -----
# SMTP 邮件通知配置
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=恒聘通 HRM <noreply@example.com>

# 企业微信 Webhook 通知（可选，用于发送实时通知到企业微信群）
# 创建方法：企业微信群 -> 群设置 -> 群机器人 -> 添加群机器人 -> 复制 Webhook 地址
WECOM_WEBHOOK_URL=

# 钉钉 Webhook 通知（可选，用于发送实时通知到钉钉群）
# 创建方法：钉钉群 -> 群设置 -> 智能群助手 -> 添加机器人 -> 自定义 -> 复制 Webhook 地址
DINGTALK_WEBHOOK_URL=
